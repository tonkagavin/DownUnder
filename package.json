{
  "name": "downunder",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web \"npm run dev -w @downunder/api\" \"npm run web -w @downunder/mobile\"",
    "dev:api": "npm run dev -w @downunder/api",
    "dev:mobile": "npm run start -w @downunder/mobile",
    "dev:web": "npm run web -w @downunder/mobile",
    "test": "npm run test --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "eval": "npm run eval -w @downunder/eval",
    "seed": "npm run seed -w @downunder/api"
  },
  "devDependencies": {
    "concurrently": "^9.2.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.5"
  }
}
